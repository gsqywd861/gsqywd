{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gsqywd",
  "compatibility_date": "2026-05-11",
  "observability": {
    "enabled": true
  },
  "assets": {
    "not_found_handling": "single-page-application",
    "headers": [
      {
        "path": "/*",
        "headers": {
          "Cross-Origin-Opener-Policy": "same-origin",
          "Cross-Origin-Embedder-Policy": "require-corp"
        }
      }
    ]
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
